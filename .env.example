# Copia questo file in `.env` e riempi i valori reali.
#
#   cp .env.example .env
#
# `.env` è in .gitignore e non va mai versionato. Questi valori hanno la
# precedenza su `config.ini`; le variabili d'ambiente reali (stesso nome)
# hanno la precedenza su questo file — comodo per systemd o Docker:
#
#   Environment=RAPPDISIBOT_BOT_TOKEN=123456:ABC...

RAPPDISIBOT_API_ID=12345
RAPPDISIBOT_API_HASH=0123456789abcdef0123456789abcdef
RAPPDISIBOT_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
